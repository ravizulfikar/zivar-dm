{
  "manifest_version": 3,
  "name": "ZIVAR Download Companion",
  "version": "0.15.0",
  "description": "Tampilkan info download browser dan kirim file atau video ke ZIVAR lokal.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "webRequest", "downloads", "tabs", "windows", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ZIVAR Downloads" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }]
}



