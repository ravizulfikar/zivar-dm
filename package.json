{
  "name": "zivar-download-manager",
  "version": "0.16.3",
  "private": true,
  "zivar": {
    "updateFeed": ""
  },
  "type": "module",
  "description": "Windows desktop download manager with Chrome companion",
  "author": "ZIVAR",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node app/server.mjs",
    "build:win": "node scripts/ensure-vendor-binaries.mjs && electron-builder --win portable nsis --x64",
    "build:firefox": "node scripts/build-firefox.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.zivar.downloadmanager",
    "productName": "ZIVAR Download Manager",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/yt-dlp",
        "to": "yt-dlp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/app.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "ZIVAR-${version}-Portable.exe"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "artifactName": "ZIVAR-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  }
}
