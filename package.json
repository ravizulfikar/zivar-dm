{
  "name": "zivar-download-manager",
  "version": "0.19.0",
  "private": true,
  "zivar": {
    "updateFeed": "https://github.com/ravizulfikar/zivar-dm/releases/latest/download/latest.json"
  },
  "type": "module",
  "description": "Download manager for Windows, macOS and Linux with a browser companion extension",
  "author": "ZIVAR",
  "license": "MIT",
  "homepage": "https://zivar.my.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravizulfikar/zivar-dm.git"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node app/server.mjs",
    "fetch:vendor": "node build/fetch-vendor.mjs",
    "build:win": "node scripts/ensure-vendor-binaries.mjs && electron-builder --config build/electron-builder.yml --win --x64",
    "build:mac": "node build/fetch-vendor.mjs && electron-builder --config build/electron-builder.yml --mac",
    "build:linux": "node build/fetch-vendor.mjs && electron-builder --config build/electron-builder.yml --linux",
    "build:firefox": "node scripts/build-firefox.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  }
}
