{
  "manifest_version": 3,
  "name": "ZIVAR Download Companion",
  "version": "0.18.1",
  "description": "Tampilkan info download browser dan kirim file atau video ke ZIVAR lokal.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage", "contextMenus", "webRequest", "downloads", "tabs", "windows", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ZIVAR Downloads", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["i18n.js", "content.js"], "all_frames": true, "run_at": "document_idle" }]
}



